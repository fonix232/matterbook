{
  "name": "matterbook-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Home Assistant sidebar panel for MatterBook",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "dev": "node esbuild.config.mjs --dev --watch",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  }
}
